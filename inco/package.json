{
  "name": "barely-amongjs-inco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy-and-write.ts --network anvil",
    "deploy:testnet": "hardhat run scripts/deploy-and-write.ts --network baseSepolia",
    "deploy:market:local": "hardhat run scripts/deploy-market.ts --network anvil",
    "deploy:market:testnet": "hardhat run scripts/deploy-market.ts --network baseSepolia",
    "deploy:ignition:local": "hardhat ignition deploy ignition/modules/AmongUsRoles.ts --network anvil",
    "deploy:ignition:testnet": "hardhat ignition deploy ignition/modules/AmongUsRoles.ts --network baseSepolia",
    "node:up": "docker compose up -d",
    "node:down": "docker compose down"
  },
  "devDependencies": {
    "@inco/lightning-js": "1.0.2",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-viem": "^0.15.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^2.0.0",
    "@types/node": ">=18.0.0",
    "hardhat": "^2.22.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "viem": "^2.43.5"
  },
  "dependencies": {
    "@inco/lightning": "1.0.2",
    "dotenv": "^17.2.3"
  }
}
