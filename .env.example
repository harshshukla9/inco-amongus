# Copy to shell env before `npm start` / `npm run build:inco`, or rely on `.inco-deploy.json`
# written by `cd inco && npm run deploy:local`.
#
# Local Docker + Anvil example:
#   export INCO_ROLES_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
#   export INCO_NETWORK=local
#   export INCO_ENABLED=true

INCO_ROLES_ADDRESS=0x95Ac9cc528512e07D8a62348727d89baAD14B5Fa
INCO_MARKET_FACTORY=0x5e53b893c888a9553f0c834156980ecace47c658
INCO_NETWORK=baseSepolia
INCO_ENABLED=false
INCO_IMPOSTOR_COUNT=1
SOCKET_URL=https://inco-amongus.onrender.com

# Server-only (Render): comma-separated browser origins allowed to connect
# CORS_ORIGINS=http://localhost:8080,https://inco-amongus.vercel.app,https://inco-amongus.onrender.com
CORS_ORIGINS=http://localhost:8080,https://inco-amongus.vercel.app,https://inco-amongus.onrender.com
